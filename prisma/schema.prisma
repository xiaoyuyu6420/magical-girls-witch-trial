generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum QuestionType {
  normal
  gate
  trigger
}

model Question {
  id           Int          @id @default(autoincrement())
  dim          String
  text         String
  order        Int
  type         QuestionType @default(normal)
  /// 渲染类型（内容层字段，与 DB type 解耦）：normal/gate/trigger/scale/weight
  /// type 仍是 enum(normal/gate/trigger)，决定打分语义；renderType 决定前端如何渲染。
  /// scale=天平题(2 option 左右对峙)、weight=砝码题(多 option 拖拽分配)
  renderType   String       @default("normal")
  meta         String       @default("")
  translations String       @default("{}")
  options      Option[]
  answers      Answer[]

  @@index([order])
}

model Option {
  id         Int      @id @default(autoincrement())
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  score      Int      @default(0)
  value      String?
  trigger    String?
  answers    Answer[]

  @@index([questionId])
}

model PersonalityType {
  id           Int     @id @default(autoincrement())
  code         String  @unique
  name         String
  subtitle     String?
  group        String
  vector       String
  slogan       String
  desc         String
  keywords     String?
  special      Boolean @default(false)
  translations String  @default("{}")
  /// 角色 IP 归属（A1/R2）：跨IP全局匹配时区分角色来自哪个作品。
  /// 默认 "witch-trial"（向后兼容现有15角色）；小圆角色为 "madoka"。
  ipCode       String  @default("witch-trial")
}

model TestRecord {
  id           Int      @id @default(autoincrement())
  sessionId    String
  resultCode   String
  similarity   Float
  userVector   String
  top3         String
  borderType   Boolean  @default(false)
  gateValue    String?
  triggerFired String?
  createdAt    DateTime @default(now())
  answers      Answer[]

  userAgent    String?
  ipAddress    String?
  screenRes    String?
  language     String?
  timezone     String?
  startedAt    DateTime?
  completedAt  DateTime?
  duration     Int?

  @@index([resultCode])
  @@index([createdAt])
  @@index([sessionId])
  @@index([gateValue])
  @@index([similarity])
}

model Answer {
  id         Int        @id @default(autoincrement())
  recordId   Int
  record     TestRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  questionId Int
  question   Question   @relation(fields: [questionId], references: [id])
  optionId   Int?
  option     Option?    @relation(fields: [optionId], references: [id], onDelete: SetNull)
}
